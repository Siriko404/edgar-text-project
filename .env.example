# Edgar-Text API Configuration
# Copy this file to .env and fill in your actual values

# SEC API Configuration
# Get your API key from https://sec-api.io/
SEC_API_KEY=your_sec_api_key_here

# Stripe Payment Configuration
# Get these from your Stripe dashboard (use test keys for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PRICE_ID=price_your_stripe_price_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Application Configuration (Optional)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# TRUSTED_HOSTS=localhost,127.0.0.1,*.yourdomain.com
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=3600

# Development Configuration (Optional)
# DEBUG=true
# LOG_LEVEL=INFO
# Edgar-Text API Configuration
# Copy this file to .env and fill in your actual values

# SEC API Configuration
# Get your API key from https://sec-api.io/
SEC_API_KEY=your_sec_api_key_here

# Stripe Payment Configuration — removed; this is a free tool with no billing.
# (STRIPE_SECRET_KEY / STRIPE_PRICE_ID / STRIPE_WEBHOOK_SECRET are not read.)

# Application Configuration (Optional)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# TRUSTED_HOSTS=localhost,127.0.0.1,*.yourdomain.com
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=3600

# Auth Configuration
# REQUIRED in production: set a stable value, otherwise each process
# generates a random secret and tokens/keys do not survive restarts.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Placeholder and very short values are ignored (a random secret is used instead).
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=24
ANONYMOUS_RATE_LIMIT=10

# Local demo account (demo@example.com) and demo API keys. Leave unset on any reachable server.
# ENABLE_DEMO_ACCOUNT=1

# Analysis Assets (Optional — defaults shown)
# LM_DICTIONARY_PATH=data/Loughran-McDonald_MasterDictionary_1993-2024.csv
# MODEL_PATH=./models/distilfinbert_onnx_q8